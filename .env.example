# Drainbench reads model API keys from the shell environment only. It never
# loads this file itself: copy the lines you need and `export` them, or use a
# tool such as direnv. Never commit real values. The mock provider needs none.

# groq:<model>, OpenAI-compatible
GROQ_API_KEY=
# openrouter:<vendor>/<model>, OpenAI-compatible
OPENROUTER_API_KEY=
# together:<model>, OpenAI-compatible
TOGETHER_API_KEY=
# openai:<model>
OPENAI_API_KEY=
# anthropic:<model>, Anthropic Messages API
ANTHROPIC_API_KEY=

# compat:<model>, any OpenAI-compatible server (Ollama, vLLM, LM Studio).
# Base URL defaults to http://localhost:11434/v1 (Ollama). Key is optional.
DRAINBENCH_COMPAT_BASE_URL=
DRAINBENCH_COMPAT_API_KEY=
